{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thankyouwine.vercel.app"
        }
      ],
      "destination": "https://thankyouwine.com/:path*",
      "permanent": true
    },
    {
      "source": "/posts/:slug(n224240070422|n224100251200|n224240112168)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/posts/:slug(n224240070422|n224100251200|n224240112168)/",
      "destination": "/blog/",
      "permanent": true
    }
  ]
}
